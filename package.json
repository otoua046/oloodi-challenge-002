{
  "name": "oloodi-staffing-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node server/main.ts",
    "reset": "node scripts/reset.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
